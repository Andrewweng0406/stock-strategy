OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
DEFAULT_MAX_LOSS_USD=250
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite+aiosqlite:///./trading_copilot.db
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=300

MOOMOO_ENABLED=true
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_OPTION_CHAIN_MAX_CALLS=8
MOOMOO_OPTION_CHAIN_WINDOW_SECONDS=30
YFINANCE_FALLBACK_ENABLED=true
# Paid/production deployments should keep this false. Set true only for a
# clearly labelled demo/sandbox where synthetic GEX values are acceptable.
SYNTHETIC_MARKET_DATA_ENABLED=false

RISK_FREE_RATE=0.045

# Cloud sync (optional): set on the LOCAL instance only, pointing at the
# cloud deployment's URL, to push real (non-mock) GEX summaries it computes
# up to the cloud's cache. Set SYNC_TOKEN to the same value on both sides.
# Never set MOOMOO_* credentials on the cloud instance itself.
CLOUD_SYNC_URL=
SYNC_TOKEN=
